##回傳推薦餐廳給使用者
def build_restaurant_result_card(restaurant):
    return {
        "type": "flex",
        "altText": f"推薦餐廳：{restaurant['name']}",
        "contents": {
            "type": "bubble",
            "body": {
                "type": "box",
                "layout": "vertical",
                "spacing": "sm",
                "contents": [
                    {
                        "type": "text",
                        "text": restaurant["name"],
                        "weight": "bold",
                        "size": "xl",
                        "wrap": True
                    },
                    {
                        "type": "text",
                        "text": restaurant["rating"],
                        "size": "md"
                    },
                    {
                        "type": "text",
                        "text": restaurant["address"],
                        "size": "sm",
                        "wrap": True,
                        "color": "#666666"
                    }
                ]
            },
            "footer": {
                "type": "box",
                "layout": "vertical",
                "spacing": "sm",
                "contents": [
                    {
                        "type": "button",
                        "style": "primary",
                        "action": {
                            "type": "uri",
                            "label": "在地圖查看",
                            "uri": restaurant["google_map_url"]
                        }
                    },
                    {
                        "type": "button",
                        "style": "secondary",
                        "action": {
                            "type": "postback",
                            "label": "再骰一次",
                            "data": "action=reroll"
                        }
                    },
                    {
                        "type": "button",
                        "style": "secondary",
                        "action": {
                            "type": "postback",
                            "label": "加入黑名單",
                            "data": "action=blacklist"
                        }
                    }
                ]
            }
        }
    }


