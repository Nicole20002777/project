def send_quick_reply(reply_token):
    message = TextSendMessage(
        text="🍽 想吃什麼類型？\n請點選，搜尋附近符合您需求的餐廳",
        quick_reply=QuickReply(
            items=[
                QuickReplyButton(action=PostbackAction(label="不限", data="type=any")),
                QuickReplyButton(action=PostbackAction(label="🔥 火鍋", data="type=hotpot")),
                QuickReplyButton(action=PostbackAction(label="🍣 日式", data="type=japanese")),
                QuickReplyButton(action=PostbackAction(label="🍝 義式", data="type=italian")),
                QuickReplyButton(action=PostbackAction(label="✏️ 自己輸入", data="type=custom"))
            ]
        )
    )
    line_bot_api.reply_message(reply_token, message)


